# Configuração do projecto num só sítio. Copiar para .env (está no .gitignore; nunca commitar):
#     cp .env.exemplo .env
# Lido por: a API (Open Liberty), scripts/*.sh, docker compose e os testes de integração.
# Formato: NOME=valor, sem aspas e sem espaços à volta do "=".

# ---------------------------------------------------------------- base de dados
BD_SERVIDOR=localhost
BD_PORTA=5432
# nome da base de dados (só aqui: nenhum outro ficheiro o repete)
BD_NOME=
# utilizador com que a API se liga (nunca o dono das tabelas); criado por scripts/criar-papel-api.sh
BD_UTILIZADOR=api_igreja
BD_SENHA=mudar
# dono/administrador: só para os scripts (criar a base, migrações, testes, backups) e o docker compose.
# No servidor de produção NÃO pôr estas duas linhas no ficheiro da API (a API não precisa delas).
BD_ADMIN_UTILIZADOR=postgres
BD_ADMIN_SENHA=postgres
# base criada e APAGADA pelos testes SQL (scripts/db-test.sh); os testes Java usam <BD_NOME_TESTE>_api.
# Tem de ser diferente de BD_NOME.
BD_NOME_TESTE=

# ---------------------------------------------------------------- API
# dev = segredos de desenvolvimento e mensagens na consola (só no PC). Em produção: apagar esta linha e
# definir JWT_SEGREDO e CODIGO_SEGREDO aleatórios (docs/producao/README.md).
MP_CONFIG_PROFILE=dev
HTTP_PORTA=9080
# no PC sem HTTPS (só no perfil dev)
COOKIE_SEGURO=false
# JWT_SEGREDO=
# CODIGO_SEGREDO=

# opcionais (valor por defeito entre parênteses)
# BD_POOL_MAX=20
# BD_TIMEOUT_CONSULTA_SEGUNDOS=30
# BD_TIMEOUT_BLOQUEIO_SEGUNDOS=5
# PEDIDO_MAX_KB=2048
# SENHAS_CONCORRENCIA=0          (0 = nº de CPUs)
# PROXY_CONFIAVEL=false
# TAREFAS_ACTIVAS=true
# LOG_FORMATO=SIMPLE              (JSON em produção)

# ---------------------------------------------------------------- SMS (lembretes de escala, recuperação de senha)
# desligado = não envia (a fila espera); consola = escreve no log (só dev); http = fornecedor de SMS
# MENSAGENS_MODO=desligado
# SMS_URL=https://...             (fornecedor: POST {"para","mensagem","remetente"} com Authorization: Bearer SMS_TOKEN)
# SMS_TOKEN=
# SMS_REMETENTE=IASD

# ---------------------------------------------------------------- Comprovativos (fotografias e PDF dos talões / M-Pesa)
# pasta no servidor onde se guardam (em dev: ~/.igreja-ficheiros); incluir nos backups
# FICHEIROS_PASTA=/var/lib/igreja/ficheiros
# FICHEIROS_MAX_KB=5120

# Fase 4 (ainda não usados)
# MPESA_API_KEY=
# MPESA_PUBLIC_KEY=
# MPESA_SERVICE_PROVIDER_CODE=
